# Generated by Terraform from templates/k3d-config.yaml.tftpl. Do not edit.
apiVersion: k3d.io/v1alpha5
kind: Simple
metadata:
  name: ${cluster_name}
servers: 1
agents: ${agents}
%{ if k3s_image != "" ~}
image: ${k3s_image}
%{ endif ~}
ports:
  - port: 127.0.0.1:${http_port}:80
    nodeFilters: [loadbalancer]
  - port: 127.0.0.1:${https_port}:443
    nodeFilters: [loadbalancer]
registries:
  create:
    name: ${registry_name}
    host: 127.0.0.1
    hostPort: "${registry_port}"
options:
  k3s:
    extraArgs:
      # ingress-nginx replaces the bundled Traefik ingress controller.
      - arg: --disable=traefik
        nodeFilters: [server:*]
  kubeconfig:
    updateDefaultKubeconfig: true
    # Don't change the current kubectl context: other clusters (e.g. a
    # cloud one) stay the default, and everything here targets this
    # cluster's context explicitly.
    switchCurrentContext: false
