# Copy this file to .env and fill in real values for local development.
# Never commit your actual .env file.

# --- Core ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# With DEBUG=False the app refuses to start without a real SECRET_KEY.
SECRET_KEY=change-this-to-a-long-random-string
# True for local development. Leave unset (False) in production.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Only needed if the site is reached through a different host than Django sees.
# CSRF_TRUSTED_ORIGINS=https://tasks.example.com

# --- Database ---
# Leave unset to use the local SQLite file (db.sqlite3).
# DATABASE_URL=postgres://user:password@localhost:5432/tasks
# Seconds to keep database connections open (0 = close after each request).
# DB_CONN_MAX_AGE=600

# --- HTTPS (only used when DEBUG=False) ---
# Set to False only to try the production setup over plain HTTP locally.
# USE_HTTPS=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# --- Email (password reset) ---
# Default prints emails to the console/server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery over SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-username
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Task Manager <noreply@example.com>
# With DEBUG=False the Docker image runs `check --deploy`, which refuses the
# console backend. Set this to accept emails only appearing in the logs.
# ALLOW_CONSOLE_EMAIL=False

# --- Gunicorn / Docker ---
# PORT=8000
# WEB_CONCURRENCY=2
# RUN_MIGRATIONS=1

# --- Login throttling (optional overrides — these are the defaults) ---
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_LOCKOUT_SECONDS=900

# API token endpoint: per-IP rate limit (optional, this is the default)
API_TOKEN_THROTTLE_RATE=10/minute
# Proxies in front of the app (usually 1 on Render/Railway), so the per-IP
# throttle sees the real client IP. Leave unset when there is no proxy.
# NUM_PROXIES=1
